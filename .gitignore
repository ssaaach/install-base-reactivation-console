__pycache__/
*.pyc
.venv/

# Regenerable from the raw cache; excluded to keep the repo a sensible size.
data/interim/
data/processed/*.parquet

# The raw downloads are ~52MB of zips. The MANIFEST is committed instead, so the
# exact pull is auditable (request body, row/column counts, SHA-256, retrieval
# time per file) and `python pipeline/run_all.py` reproduces them.
data/raw/*.zip
# The BSEE archives and everything unpacked from them. Same treatment as the
# USAspending zips: regenerable in seconds by fetch_bsee.py, and the manifest
# below records each  file's row count and SHA-256 so the pull stays auditable.
data/raw/bsee/
data/raw/*.part

# Committed on purpose, despite living under data/: these are small, and they are
# what makes the pull and the provenance checkable without re-running anything.
!data/raw/manifest.json
!data/raw/plan.json
!data/processed/*.json
!data/processed/*.csv

# Build intermediate: export_app_data.py writes it, build_app.py inlines it into
# app/dist/index.html. Committing both would duplicate 4.6MB of the same JSON.
app/data/app_data.json

# The original brief. Kept locally, deliberately not published.
Prompt_1.md

# Written by the Vercel CLI on `vercel link`. .env.local holds a
# VERCEL_OIDC_TOKEN and .vercel/ holds the project linkage - neither belongs in
# the repo. The CLI adds these itself; kept here so the protection is recorded.
.vercel
.env*

# Private working notes - operational status, local paths, auth state.
# Eyes only: never published, same treatment as the original brief.
context.md

# Pre-theme backups of the files the restyle rewrote. Kept locally as a
# rollback; git already has the originals, so they never need committing.
*.bak

# Working build prompt. Local only, same treatment as the original brief.
OFFSHORE_PROMPT.md
